# Required
DISCORD_BOT_TOKEN=PASTE_TOKEN_HERE
DISCORD_GUILD=123456789012345678
DISCORD_GUILD_RULES_CHANNEL=123456789012345678

# Optional
BOT_MODE=validate          # validate | dry_run | apply
BOT_MESSAGE_DELAY=1        # seconds between posts
DISCORD_MENTIONS=no        # yes/no; default no
# BOT_RULES_DIR=.          # overrides rules directory (default repo root)
